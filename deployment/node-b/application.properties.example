# =============================================================================
# NEXUS Distributed Chat — Node B (Physical Machine B) Configuration
# =============================================================================

# Server Node Identity
server.id=server-b

# Physical Machine B reachable LAN IP (e.g. 192.168.1.102)
# Advertised to remote clients and Peer A
server.advertised.host=192.168.1.102

# Local RMI Ports (can be 1099/1100 on distinct machine, or 2099/2100 on single machine test)
server.rmi.registry.port=1099
server.rmi.service.port=1100

# Security Token for Administrative Telemetry Monitoring
server.admin.token=nexus-admin-secret-b

# -----------------------------------------------------------------------------
# Peer Server Node A Endpoint
# -----------------------------------------------------------------------------
server.peer.id=server-a
server.peer.host=192.168.1.101
server.peer.registry.port=1099
server.peer.service.port=1100

# -----------------------------------------------------------------------------
# Database B (Local MySQL / MariaDB on Computer B)
# -----------------------------------------------------------------------------
database.enabled=true
database.host=127.0.0.1
database.port=3306
database.name=nexus_chat_b
database.username=nexus_user
database.password=PLACEHOLDER_DB_PASSWORD
database.pool.max-size=10
